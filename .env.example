APP_NAME="MoneyClips"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laravel roda NATIVO: `php artisan serve` sobe em 127.0.0.1:8000.
APP_URL=http://127.0.0.1:8000
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=generate_clips_laravel
DB_USERNAME=root
DB_PASSWORD=root

# MinIO externo no host, acessado pelo Laravel nativo em 127.0.0.1.
# REGRA DA CASA: só o Laravel toca o S3 — os microserviços recebem/entregam
# o vídeo por HTTP (multipart). Exceção: download-shorts (produtor) sobe
# direto pro MinIO com credenciais próprias.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=video
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
S3_PREFIX=shorts/

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# ⚠️ Precisa bater EXATAMENTE com o "Authorized redirect URI" no Google Cloud
# Console. Em dev nativo é :8000; em prod, o domínio real (nginx :80/HTTPS).
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth2/google/callback

# API key da Google Drive API (só leitura de pastas públicas "qualquer pessoa
# com o link"). Usada pelo comando `drive:download-videos`. Crie no Google Cloud
# Console (APIs & Services -> Credentials) com a Drive API habilitada.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_TIMEOUT=300

# ---------------------------------------------------------------------------
# Microserviços (todos NATIVOS, sem docker — `make up` sobe tudo).
#   - Saída (Laravel -> microserviço): 127.0.0.1:<porta>
#   - Callback (microserviço -> Laravel): 127.0.0.1:8000 em dev;
#     em PROD, o domínio real (nginx :80/HTTPS).
# ---------------------------------------------------------------------------

# download-shorts (FastAPI :8770): baixa Shorts de um canal e sobe pro MinIO.
DOWNLOAD_YOUTUBE_URL=http://127.0.0.1:8770
DOWNLOAD_YOUTUBE_TIMEOUT=30
DOWNLOAD_YOUTUBE_WEBHOOK_URL=http://127.0.0.1:8000/api/download-youtube/webhook

# tiktok-uploader (Node/Playwright :8090): POST /posts multipart ASSÍNCRONO —
# o Laravel envia o binário + cookies + webhook_url, recebe 202 {job_id} e o
# desfecho (completed|dry-run|restricted|failed) chega no webhook abaixo.
# O timeout cobre só o envio do binário; em prod aponte o webhook pro domínio real.
TIKTOK_POST_URL=http://127.0.0.1:8090
TIKTOK_POST_TIMEOUT=120
TIKTOK_POST_WEBHOOK_URL=http://127.0.0.1:8000/api/tiktok-posts/webhook
TIKTOK_POST_API_TOKEN=
TIKTOK_ACCOUNT_NAME=

# ── Credenciais de APP das APIs oficiais (posters stub — preencher ao ativar) ──
# TikTok for Developers (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta for Developers (Instagram Reels + Facebook Reels, mesmo app)
META_APP_ID=
META_APP_SECRET=
# Kwai Open Platform
KWAI_APP_ID=
KWAI_APP_SECRET=

# video (Node/ffmpeg :8790) — UM serviço, dois endpoints. As duas URLs abaixo
# apontam pro mesmo host:porta; os timeouts é que diferem.
#
# POST /reencode: multipart síncrono — devolve o vídeo recodificado na resposta
# (sem S3).
REENCODE_URL=http://127.0.0.1:8790
REENCODE_TIMEOUT=900
REENCODE_API_TOKEN=

# POST /package: empacota vídeos longos em HLS/ABR para reprodução rápida.
# Assíncrono: 202 {uuid} e o desfecho chega no webhook. ATENÇÃO — este endpoint
# lê e escreve no MinIO por conta própria (2ª exceção à regra "só o Laravel
# toca o S3"): milhares de segmentos por vídeo inviabilizam trafegar por HTTP.
# HLS_API_TOKEN precisa bater com o API_TOKEN do serviço, que o usa como
# X-Observability-Token no webhook — sem isso o vídeo trava em "packaging".
# (HLS_API_TOKEN e REENCODE_API_TOKEN são o mesmo API_TOKEN agora.)
HLS_URL=http://127.0.0.1:8790
HLS_TIMEOUT=60
HLS_API_TOKEN=
HLS_WEBHOOK_URL=http://127.0.0.1:8000/api/hls/webhook
# accel = nginx entrega os segmentos (X-Accel-Redirect); stream = pelo PHP,
# necessário sob `php artisan serve`, que não entende o header.
HLS_DELIVERY=stream

# POST /videos: render de template (legenda karaokê + moldura do canal).
# Assíncrono: avisa o webhook e o Laravel baixa o output em
# /videos/{uuid}/output/{variant}. Roda no MESMO serviço video (:8790) — só a
# transcrição continua em Python (o autocaption em :8780, que o video chama).
AUTOCAPTION_URL=http://127.0.0.1:8790
AUTOCAPTION_TIMEOUT=300
AUTOCAPTION_WEBHOOK_URL=http://127.0.0.1:8000/api/autocaption/webhook
# defaults do editor de template (/meus-videos): white|black|vertical + marca
AUTOCAPTION_DEFAULT_STYLE=white
AUTOCAPTION_CHANNEL_NAME=
AUTOCAPTION_CHANNEL_HANDLE=

# Observabilidade (OBSERVABILITY.md): token compartilhado dos endpoints
# /api/observability/* — precisa bater com o OBSERVABILITY_TOKEN dos serviços.
OBSERVABILITY_TOKEN=

# Discord — alertas de postagem, estoque baixo e serviço fora do ar.
DISCORD_WEBHOOK_URL=
