APP_NAME="Template Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=template_project
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=true

# ---------------------------------------------------------------------------
# MinIO (armazenamento de objetos — compartilhado com a API Python)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_BUCKET=auto-post
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# API Python de processamento de vídeo (generate-clips)
# ---------------------------------------------------------------------------
# URL base HTTP da API Python (chamadas de orquestração Laravel → Python)
PYTHON_API_BASE_URL=http://127.0.0.1:8765
# URL base WebSocket (consumida pelo browser para progresso em tempo real)
PYTHON_API_WS_URL=ws://127.0.0.1:8765
# Token enviado pelo Laravel no header Authorization ao chamar a API Python.
# Deve coincidir com PYTHON_API_TOKEN no .env do projeto Python.
PYTHON_API_TOKEN=
# Token que o Python devolve nos callbacks de webhook.
# Deve coincidir com PYTHON_CALLBACK_TOKEN no .env do projeto Python.
PYTHON_CALLBACK_TOKEN=
# Timeout (segundos) das chamadas HTTP síncronas ao Python
PYTHON_API_TIMEOUT=120

# OAuth das redes sociais (Socialite) — apps de desenvolvedor de cada plataforma.
# Google cobre o YouTube; Meta (Facebook) cobre Instagram + Facebook.
# Google Auth (login/cadastro do usuario final). Se vazio, reaproveita o client do YouTube.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=

# YouTube Data API key: permite consultas públicas, mas não autoriza uploads.
YOUTUBE_API_KEY=
# YouTube OAuth — se vazio, reaproveita GOOGLE_AUTH_CLIENT_ID/SECRET.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_VERSION=v21.0

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Publicação social (social-publishing)
# ---------------------------------------------------------------------------
# Plataformas ativas, separadas por vírgula
SOCIAL_ENABLED_PLATFORMS=youtube,tiktok
# Tentativas máximas por post antes de marcar como falho
SOCIAL_PUBLISH_MAX_ATTEMPTS=3
# ID do usuário dono das contas sociais (usado em jobs automáticos)
SOCIAL_ACCOUNT_OWNER_ID=1

# ---------------------------------------------------------------------------
# YouTube Shorts (pipeline de auto-postagem, unificado do auto-post)
# ---------------------------------------------------------------------------
# Disk de onde os vídeos do estoque são lidos para postagem
YOUTUBE_SHORTS_DISK=minio
# Postagem automática: public | unlisted | private
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=22
# Quantos posts por execução do youtube:dispatch-posts
YOUTUBE_POSTS_PER_RUN=1
# Aviso de estoque baixo no Discord (fração restante, 0.20 = 20%)
YOUTUBE_LOW_STOCK_THRESHOLD=0.20
# Liga/desliga cada plataforma na auto-postagem (cron). Para pausar uma, ponha
# false e rode `php artisan config:clear`.
AUTO_POST_YOUTUBE_ENABLED=true
AUTO_POST_TIKTOK_ENABLED=true
# Webhook do Discord para notificações de postagem/estoque/falha
YOUTUBE_SHORTS_DISCORD_WEBHOOK=

# ---------------------------------------------------------------------------
# Microserviço tiktok-uploader (Node + Playwright, porta 8780)
# ---------------------------------------------------------------------------
# Publica Shorts no TikTok via navegador e grava o ciclo de vida na tabela
# tiktok_posts DESTE banco (o uploader conecta direto no MySQL).
TIKTOK_UPLOADER_URL=http://127.0.0.1:8780
# Timeout (segundos) das chamadas HTTP (só enfileiram; a postagem é assíncrona)
TIKTOK_UPLOADER_TIMEOUT=30

# ---------------------------------------------------------------------------
# Microserviços do fluxo simplificado de downloads/postagens
# ---------------------------------------------------------------------------
# Os serviços rodam em container (docker-compose.yml na raiz). O Laravel (no
# host) os chama pelas portas publicadas em 127.0.0.1. JÁ os callbacks que os
# CONTAINERS enviam de volta precisam usar host.docker.internal: dentro do
# container, localhost/127.0.0.1 é o próprio container, não o host. Sirva o
# Laravel em 0.0.0.0 (php artisan serve --host=0.0.0.0) para receber.

# download-youtube/download-shorts: cria jobs de download e lista o estoque.
DOWNLOAD_YOUTUBE_URL=http://127.0.0.1:8770
DOWNLOAD_YOUTUBE_TIMEOUT=30
# Callback do container -> Laravel no host:
DOWNLOAD_YOUTUBE_WEBHOOK_URL=http://host.docker.internal:8000/api/download-youtube/webhook

# tiktok-post/tiktok-uploader: enfileira posts por video_id e chama callback.
TIKTOK_POST_URL=http://127.0.0.1:8090
TIKTOK_POST_TIMEOUT=30
TIKTOK_POST_API_TOKEN=
# Callback do container -> Laravel no host:
TIKTOK_POST_CALLBACK_URL=http://host.docker.internal:8000/api/tiktok-posts/callback
