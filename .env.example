APP_NAME="generate-clips-laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laravel roda NATIVO: `php artisan serve` sobe em 127.0.0.1:8000.
APP_URL=http://127.0.0.1:8000
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=generate_clips_laravel
DB_USERNAME=root
DB_PASSWORD=root

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=video
# MinIO externo no host, acessado pelo Laravel nativo em 127.0.0.1.
# (Os microserviços em container usam host.docker.internal fixo no compose.)
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

S3_PREFIX=shorts/

GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# ⚠️ Precisa bater EXATAMENTE com o "Authorized redirect URI" no Google Cloud
# Console. Em dev nativo é :8000; em prod, o domínio real (nginx :80/HTTPS).
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth2/google/callback

# ---------------------------------------------------------------------------
# Microserviços (docker-compose.yml). Regra de rede com Laravel NATIVO:
#   - Saída (Laravel -> container publicado): 127.0.0.1:<porta>
#   - Callback (container -> Laravel nativo): host.docker.internal:8000
# Em PROD, os callbacks apontam pro domínio real (nginx :80/HTTPS), não :8000.
# ---------------------------------------------------------------------------
DOWNLOAD_YOUTUBE_URL=http://127.0.0.1:8770
DOWNLOAD_YOUTUBE_TIMEOUT=30
DOWNLOAD_YOUTUBE_WEBHOOK_URL=http://host.docker.internal:8000/api/download-youtube/webhook

# tiktok-post/tiktok-uploader: enfileira posts por video_id e chama callback.
TIKTOK_POST_URL=http://127.0.0.1:8090
TIKTOK_POST_TIMEOUT=30
TIKTOK_POST_API_TOKEN=
TIKTOK_POST_CALLBACK_URL=http://host.docker.internal:8000/api/tiktok-posts/callback

TIKTOK_ACCOUNT_NAME=
TIKTOK_ACCOUNT_EMAIL=
TIKTOK_ACCOUNT_PASSWORD=
ROBOFLOW_API_KEY=
S3_DOWNLOAD_RETRIES=3
S3_DOWNLOAD_RETRY_DELAY_MS=2000
HEADLESS=true
STEALTH=false
DRY_RUN=true
DISCORD_WEBHOOK_URL=
