APP_NAME="generate-clips-laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://clips.localhost
APP_PORT=80

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=generate_clips_laravel
DB_USERNAME=root
DB_PASSWORD=root

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=video
AWS_ENDPOINT=http://host.docker.internal:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=host.docker.internal

REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=host.docker.internal
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

S3_PREFIX=shorts/

GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1/oauth2/google/callback

# ---------------------------------------------------------------------------
# Microservicos no docker-compose.yml
# ---------------------------------------------------------------------------
DOWNLOAD_YOUTUBE_URL=http://download-shorts:8770
DOWNLOAD_YOUTUBE_TIMEOUT=30
DOWNLOAD_YOUTUBE_WEBHOOK_URL=http://laravel/api/download-youtube/webhook

TIKTOK_POST_URL=http://tiktok-uploader:8090
TIKTOK_POST_TIMEOUT=30
TIKTOK_POST_API_TOKEN=
TIKTOK_POST_CALLBACK_URL=http://laravel/api/tiktok-posts/callback

TIKTOK_ACCOUNT_NAME=
TIKTOK_ACCOUNT_EMAIL=
TIKTOK_ACCOUNT_PASSWORD=
ROBOFLOW_API_KEY=
S3_DOWNLOAD_RETRIES=3
S3_DOWNLOAD_RETRY_DELAY_MS=2000
HEADLESS=true
STEALTH=false
DRY_RUN=true
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Sync S3 -> MinIO (artisan s3:sync-to-minio)
# ---------------------------------------------------------------------------
S3_SYNC_SOURCE_ENDPOINT=https://usc1.contabostorage.com
S3_SYNC_SOURCE_REGION=usc1
S3_SYNC_SOURCE_ACCESS_KEY=
S3_SYNC_SOURCE_SECRET_KEY=
S3_SYNC_SOURCE_BUCKET=video
S3_SYNC_SOURCE_PREFIX=shorts
