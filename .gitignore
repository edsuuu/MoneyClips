# MicroServices/ é versionado (monorepo). Ignora só segredos e artefatos pesados
# de cada serviço — nunca a pasta inteira.
/MicroServices/.env
/MicroServices/*/.env
/MicroServices/*/.venv
/MicroServices/*/venv
/MicroServices/*/node_modules
/MicroServices/**/__pycache__
/MicroServices/**/*.pyc
/MicroServices/*/.mypy_cache
/MicroServices/*/.ruff_cache
/MicroServices/*/.pytest_cache
/MicroServices/generate-clips/models
/MicroServices/generate-clips/output
/MicroServices/*/*.log
# Cookies de sessão do TikTok (credenciais) — versiona só o .gitkeep
/MicroServices/TikTokAutoUploader/cookies/*
!/MicroServices/TikTokAutoUploader/cookies/.gitkeep
