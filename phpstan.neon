includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes

    level: max

    # Os models declaram casts via método casts(); sem isto o larastan não os
    # enxerga (instancia o model sem construtor) e tipa as colunas casteadas
    # como string|null cru do schema.
    parseModelCastsMethod: true

    tmpDir: /tmp/phpstan

    # Casts diretos de valores `mixed` (config, JSON de API, payloads) são aceitos:
    # trocamos o helper App\Support\Cast por (string)/(int)/(float)/(array) e
    # relaxamos só estas regras de cast — o resto segue no nível max.
    ignoreErrors:
        - identifier: cast.string
        - identifier: cast.int
        - identifier: cast.double

    excludePaths:
        - database/migrations/*
