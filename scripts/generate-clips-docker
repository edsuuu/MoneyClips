#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CUDA_TEST_IMAGE="${CUDA_TEST_IMAGE:-nvidia/cuda:12.6.3-base-ubuntu24.04}"

cd "$ROOT_DIR"

action="${1:-up}"

detect_gpu() {
    local os_name
    os_name="$(uname -s)"

    if [[ "$os_name" == "Darwin" ]]; then
        echo "macOS detectado."
        echo "Docker Desktop no macOS não expõe CUDA/NVIDIA para containers."
        echo "Rode o generate-clips nativo para usar Metal/VideoToolbox:"
        echo "  cd MicroServices/GenerateClips && python main.py"
        return 1
    fi

    if [[ "$os_name" != "Linux" ]]; then
        echo "Sistema não suportado para este profile CUDA: $os_name"
        return 1
    fi

    local arch
    arch="$(uname -m)"
    if [[ "$arch" != "x86_64" && "$arch" != "amd64" ]]; then
        echo "Este profile CUDA está preparado para Linux x86_64. Arquitetura detectada: $arch"
        return 1
    fi

    if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo "nvidia-smi não encontrado no host Linux."
        echo "Instale o driver NVIDIA e o NVIDIA Container Toolkit antes de subir o container GPU."
        return 1
    fi

    if ! nvidia-smi -L >/dev/null 2>&1; then
        echo "Nenhuma GPU NVIDIA válida foi encontrada pelo nvidia-smi."
        return 1
    fi

    if ! docker info >/dev/null 2>&1; then
        echo "Docker não está respondendo neste host."
        return 1
    fi

    if ! docker run --rm --gpus all "$CUDA_TEST_IMAGE" nvidia-smi >/dev/null 2>&1; then
        echo "Docker ainda não consegue acessar a GPU NVIDIA."
        echo "No Linux, configure o NVIDIA Container Toolkit e reinicie o Docker:"
        echo "  sudo nvidia-ctk runtime configure --runtime=docker"
        echo "  sudo systemctl restart docker"
        return 1
    fi

    echo "GPU NVIDIA validada para Docker/CUDA."
}

case "$action" in
    check)
        detect_gpu
        ;;
    up)
        detect_gpu
        docker compose --profile linux-nvidia up -d --build
        ;;
    logs)
        docker compose logs -f generate-clips
        ;;
    down)
        docker compose --profile linux-nvidia stop generate-clips
        ;;
    *)
        echo "Uso: scripts/generate-clips-docker [check|up|logs|down]"
        exit 2
        ;;
esac
