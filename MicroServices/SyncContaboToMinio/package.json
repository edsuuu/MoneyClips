{
  "name": "sync-contabo-to-minio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Sincroniza objetos do S3 da Contabo para um MinIO local",
  "scripts": {
    "sync": "node sync.js",
    "sync:dry": "node sync.js --dry-run",
    "sync:fast": "node sync.js --concurrency=16 --scan-concurrency=32"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "dotenv": "^16.4.5"
  }
}
