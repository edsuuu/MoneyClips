API_HOST=0.0.0.0
API_PORT=8770
LOG_LEVEL=INFO

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=videos
STORAGE_SECURE=false
STORAGE_REGION=us-east-1
STORAGE_USE_PATH_STYLE=true
STORAGE_PATH_PREFIX=shorts

TEMP_DIR=/tmp/media
DOWNLOAD_WORKERS=8
MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_DELAYS_SECONDS=[1.0,5.0,15.0]

# Encoder pra transcodificacao quando o source nao e mp4/H.264.
# none = CPU (x264, default) | nvenc = NVIDIA | videotoolbox = Apple Silicon
GPU_ENCODER=nvenc

# Transcricao (faster-whisper, fila propria). Em macOS o device cai pra
# cpu/int8 automaticamente; cuda so vale em Linux/NVIDIA.
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Observabilidade (OBSERVABILITY.md): push de logs + heartbeat pro Laravel.
# Vazio = desligado (log local continua normal).
OBSERVABILITY_URL=http://127.0.0.1:8000/api/observability
OBSERVABILITY_TOKEN=
SERVICE_NAME=media
