# Reencode. REENCODE_ENABLED=false desliga (o serviço responde sempre
# {status: "skipped"}). Só recodifica quando o bitrate do vídeo está abaixo
# do limiar (kbps). NVENC (GPU) se disponível, senão libx264 (CPU).
#
# Regra da casa: o serviço NÃO acessa S3/MinIO — o Laravel envia o binário
# por multipart em POST /reencode e recebe o vídeo recodificado na resposta.
REENCODE_ENABLED=true
REENCODE_BITRATE_THRESHOLD_KBPS=4000

# Discord (opcional) — recebe aviso quando um reencode falha.
DISCORD_WEBHOOK_URL=

# API — porta própria (diferente da do Laravel). O Laravel chama:
#   POST /reencode  multipart { video: <arquivo>, video_id: "abc" (opcional) }
#   → 200 binário do vídeo recodificado (header X-Reencode: completed)
#   → 200 JSON {"status": "skipped"} quando o bitrate já está ok
API_PORT=8790
# Token opcional: se preenchido, POST /reencode exige
# `Authorization: Bearer <token>` (ou header X-Api-Token). Vazio = aberto (dev).
API_TOKEN=

# Observabilidade (OBSERVABILITY.md): push de logs + heartbeat pro Laravel.
# Vazio = desligado (log local continua normal).
OBSERVABILITY_URL=http://127.0.0.1:8000/api/observability
OBSERVABILITY_TOKEN=
SERVICE_NAME=reencode
