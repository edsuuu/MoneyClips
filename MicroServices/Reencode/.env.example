# Storage S3-compatível. Local = MinIO (docker-compose sobe um). Credenciais
# locais não são segredo (MinIO de dev), por isso vão preenchidas aqui.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_BUCKET=video
S3_PREFIX=shorts/

# Retry do download do S3 (erros transitórios: ECONNREFUSED, timeout, 5xx).
S3_DOWNLOAD_RETRIES=3
S3_DOWNLOAD_RETRY_DELAY_MS=2000

# Reencode. REENCODE_ENABLED=false desliga (o serviço vira passthrough: sempre
# devolve a chave de origem). Só recodifica quando o bitrate do vídeo está
# abaixo do limiar (kbps). NVENC (GPU) se disponível, senão libx264 (CPU).
REENCODE_ENABLED=true
REENCODE_BITRATE_THRESHOLD_KBPS=4000

# Discord (opcional) — recebe aviso quando um job falha.
DISCORD_WEBHOOK_URL=

# API — porta própria (diferente da do Laravel). O Laravel chama:
#   POST /reencode { "video_id": "abc", "webhook_url": "https://laravel/.../callback",
#                    "source_key": "shorts/abc/short_abc.mp4" (opcional),
#                    "output_key": "shorts/abc/short_abc_HQ.mp4" (opcional) }
# e recebe o resultado de volta nesse webhook_url ao fim.
API_PORT=8790
# Token opcional: se preenchido, POST /reencode exige
# `Authorization: Bearer <token>` (ou header X-Api-Token). Vazio = aberto (dev).
API_TOKEN=
