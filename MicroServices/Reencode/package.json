{
    "name": "reencode",
    "version": "0.1.0",
    "description": "Microserviço que recodifica vídeos de baixo bitrate (CQ/CRF 18, NVENC/libx264) a partir de um storage S3-compatível",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "tsx src/server.ts",
        "api": "tsx src/server.ts",
        "dev": "nodemon --watch src --ext ts --exec \"tsx src/server.ts\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "tsx": "^4.19.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.5",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.14.0",
        "jiti": "^2.4.2",
        "nodemon": "^3.1.14",
        "prettier": "^3.4.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    }
}
