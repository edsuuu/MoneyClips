# Storage S3-compatível. Local = MinIO (docker-compose sobe um). Credenciais
# locais não são segredo (MinIO de dev), por isso vão preenchidas aqui.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_BUCKET=video
S3_PREFIX=shorts/

# TikTok — email/senha para login automático. Vazios = só com cookie manual.
TIKTOK_ACCOUNT_NAME=clipsd211
TIKTOK_ACCOUNT_EMAIL=seu_email@exemplo.com
TIKTOK_ACCOUNT_PASSWORD=sua_senha

# Roboflow (captcha) — opcional, já tem default.
ROBOFLOW_API_KEY=kyHFbAWkOWfGz8fSEw8O

# Automação. HEADLESS=false mostra o navegador; STEALTH=true adiciona atrasos.
HEADLESS=false
STEALTH=false

# DRY_RUN=true faz todo o processo menos publicar. =false publica de verdade.
DRY_RUN=true

# Proxy do navegador (opcional). SOCKS5 no Chromium não suporta auth (user/senha só em HTTP).
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Locale/timezone do navegador. Vazio = automático conforme o proxy.
BROWSER_LOCALE=
BROWSER_TIMEZONE=

# Discord (opcional) — recebe aviso quando o login automático falha.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu_webhook_aqui

# API — porta própria (diferente da do Laravel). O Laravel chama:
#   POST /posts { "video_id": "abc", "webhook_url": "https://laravel/.../callback",
#                 "title": "...", "hashtags": ["#a", "#b"] }
# e recebe o resultado de volta nesse webhook_url ao fim.
API_PORT=8090
# Token opcional: se preenchido, POST /posts e GET /session exigem
# `Authorization: Bearer <token>` (ou header X-Api-Token). Vazio = aberto (dev).
API_TOKEN=
