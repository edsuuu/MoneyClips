#!/usr/bin/env sh
# Bloqueia o commit se lint ou typecheck falharem.
# Ativado por `git config core.hooksPath .githooks` (script "prepare" do package.json).

echo "pre-commit: rodando lint + typecheck..."

if ! npm run --silent lint; then
    echo "✖ lint falhou — commit abortado. Rode 'npm run lint:fix' e tente de novo." >&2
    exit 1
fi

if ! npm run --silent typecheck; then
    echo "✖ typecheck falhou — commit abortado." >&2
    exit 1
fi

echo "✓ lint + typecheck OK"
