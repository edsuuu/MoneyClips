# Origem: S3 da Contabo
STORAGE_ENDPOINT=https://usc1.contabostorage.com
STORAGE_REGION=usc1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=videos
STORAGE_PATH_PREFIX=shorts
STORAGE_USE_PATH_STYLE=true

# Destino: MinIO local (default minioadmin/minioadmin)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Se vazio, usa o mesmo nome do bucket de origem.
MINIO_BUCKET=
