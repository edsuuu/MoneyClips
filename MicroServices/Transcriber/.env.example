API_HOST=0.0.0.0
API_PORT=8780
LOG_LEVEL=INFO

# Transcrição (faster-whisper). É a ÚNICA coisa que este serviço faz — legenda,
# template e render das variantes vivem no microserviço Video (Node, :8790).
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Observabilidade (OBSERVABILITY.md): push de logs + heartbeat pro Laravel.
# Vazio = desligado (log local continua normal).
OBSERVABILITY_URL=http://127.0.0.1:8000/api/observability
OBSERVABILITY_TOKEN=
SERVICE_NAME=transcriber
