API_HOST=0.0.0.0
API_PORT=8780
LOG_LEVEL=INFO
# abre o navegador automaticamente ao subir o servidor (deixe false no make up)
AUTO_OPEN=false

# Pasta local onde cada vídeo vira storage/<uuid>/...
STORAGE_DIR=./storage

# Transcrição (faster-whisper)
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=16

# Encoder da queima (qualidade máxima): nvenc (GPU) | libx264 (CPU)
GPU_ENCODER=nvenc

# Estilo da legenda karaokê
MAX_WORDS_PER_LINE=3
MAX_LINE_DURATION=2.5
# fonte precisa estar instalada no sistema (fc-list)
FONT_NAME=Realist Clostan
FONT_SIZE=12
# amarelo no formato ASS (AABBGGRR)
HIGHLIGHT_COLOR=&H0000FFFF&
HIDE_FUTURE_WORDS=true
SUBTITLE_OFFSET=0.0

# Marca do template (só o @handle é exibido no cabeçalho)
CHANNEL_NAME=meu_canal
CHANNEL_HANDLE=@meu_canal
CHANNEL_LOGO=./assets/logo.png
# fonte TTF/OTF do @handle no cabeçalho (path; vazio = DejaVu Sans Bold)
TEMPLATE_FONT_PATH=
# marca d'água no centro do vídeo (vazio = desligada)
WATERMARK_TEXT=

# Variantes geradas: original,vertical,template_white,template_black
OUTPUT_VARIANTS=original,vertical,template_white,template_black

# Observabilidade (OBSERVABILITY.md): push de logs + heartbeat pro Laravel.
# Vazio = desligado (log local continua normal).
OBSERVABILITY_URL=http://127.0.0.1:8000/api/observability
OBSERVABILITY_TOKEN=
SERVICE_NAME=autocaption
