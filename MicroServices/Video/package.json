{
    "name": "video",
    "version": "0.1.0",
    "description": "Microserviço de vídeo (ffmpeg): empacota vídeos longos em HLS/ABR (assíncrono, lê/escreve MinIO) e recodifica shorts de baixo bitrate (síncrono, multipart)",
    "type": "module",
    "packageManager": "pnpm@10.24.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "start": "node dist/App.js",
        "dev": "nodemon",
        "typecheck": "tsc --noEmit",
        "lint": "eslint app tests",
        "lint:fix": "eslint app tests --fix",
        "format": "prettier --write \"{app,tests}/**/*.ts\"",
        "test": "tsx tests/SubtitleGoldenTest.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "morgan": "^1.11.0",
        "multer": "^2.0.0",
        "sharp": "^0.35.3",
        "tsx": "^4.19.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.10.5",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.14.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.4.2",
        "tsup": "^8.5.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    }
}
