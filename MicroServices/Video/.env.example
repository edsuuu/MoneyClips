# HLS — POST /package (assíncrono, 202 {uuid} + webhook). Este endpoint lê e
# escreve no MinIO por conta própria (exceção à regra "só o Laravel toca o S3").
HLS_ENCODER=gpu
HLS_SEGMENT_SECONDS=6
HLS_WORK_DIR=

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=videos
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Reencode — POST /reencode (síncrono, multipart; sem S3). REENCODE_ENABLED=false
# faz o serviço responder sempre {status: "skipped"}. Só recodifica quando o
# bitrate do vídeo está abaixo do limiar (kbps). NVENC (GPU) se disponível,
# senão libx264 (CPU).
REENCODE_ENABLED=true
REENCODE_BITRATE_THRESHOLD_KBPS=4000

# Legenda/template — POST /videos (assíncrono, 202 {uuid} + webhook). A
# transcrição é o único passo que continua em Python (faster-whisper/CUDA):
# este serviço manda o wav pro TRANSCRIBER_URL e faz todo o resto.
CAPTION_STORAGE_DIR=./storage
TRANSCRIBER_URL=http://127.0.0.1:8780
TRANSCRIBER_TIMEOUT_MS=1800000

# Estilo da legenda karaokê
MAX_WORDS_PER_LINE=3
MAX_LINE_DURATION=2.5
# fonte precisa estar instalada no sistema (fc-list) — o libass resolve por nome
FONT_NAME=Realist Clostan
FONT_SIZE=12
# amarelo no formato ASS (AABBGGRR)
HIGHLIGHT_COLOR=&H0000FFFF&
HIDE_FUTURE_WORDS=true
SUBTITLE_OFFSET=0.0

# Marca do template
CHANNEL_NAME=meu_canal
CHANNEL_HANDLE=@meu_canal
CHANNEL_LOGO=./assets/logo.png
# família da fonte do cabeçalho (nome do fontconfig, não caminho de arquivo)
TEMPLATE_FONT_FAMILY=DejaVu Sans
# marca d'água no centro do vídeo (vazio = desligada)
WATERMARK_TEXT=
OUTPUT_VARIANTS=original,vertical,template_white,template_black

# Discord (opcional) — recebe aviso quando uma rota estoura erro interno.
DISCORD_WEBHOOK_URL=

API_PORT=8790
API_TOKEN=

OBSERVABILITY_URL=http://127.0.0.1:8000/api/observability
OBSERVABILITY_TOKEN=
SERVICE_NAME=video
