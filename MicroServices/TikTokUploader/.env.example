# Roboflow (solver de captcha). Obtenha a sua em https://app.roboflow.com
# ⚠️ Nunca commite a chave real — a que vazou em versões antigas deve ser rotacionada.
ROBOFLOW_API_KEY=

SHOW_BROWSER=false
# DRY_RUN=true pula a publicação real (debugging). Deixe false em produção.
DRY_RUN=true

# Discord (opcional) — avisos de erro/post. Rotacione o webhook se já vazou.
DISCORD_WEBHOOK_URL=
DISCORD_USER_NOTIFIER=

API_PORT=8090

# Observabilidade (OBSERVABILITY.md): push de logs + heartbeat pro Laravel.
# Vazio = desligado (log local continua normal).
OBSERVABILITY_URL=http://127.0.0.1:8000/api/observability
OBSERVABILITY_TOKEN=
SERVICE_NAME=tiktok-uploader
