{
    "name": "tiktok-auto-uploader",
    "version": "0.1.0",
    "description": "Microserviço que posta vídeos no TikTok via Playwright (stealth), recebendo o binário do vídeo, cookies e metadados por multipart",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "start": "node dist/App.js",
        "dev": "nodemon",
        "typecheck": "tsc --noEmit",
        "lint": "eslint app",
        "lint:fix": "eslint app --fix",
        "format": "prettier --write \"app/**/*.ts\"",
        "postinstall": "playwright install chromium"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "playwright": "^1.48.2",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "tsx": "^4.19.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.10.5",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.14.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.4.2",
        "tsup": "^8.5.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    }
}
